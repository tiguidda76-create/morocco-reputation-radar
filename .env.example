# =================================================================
# MOROCCO REPUTATION RADAR - META WHATSAPP CLOUD API CONFIGURATION
# =================================================================

# 1. Jeton d'accès Meta (Temporary Access Token ou System User Permanent Token)
# Obtenu sur: https://developers.facebook.com/apps/ > WhatsApp > API Setup
VITE_META_WHATSAPP_TOKEN=your_meta_access_token_here

# 2. Identifiant du numéro de téléphone (Phone Number ID) - numéro à 15 chiffres
VITE_META_PHONE_ID=your_phone_number_id_here

# 3. (Optionnel) Identifiant du compte WhatsApp Business (WABA ID)
VITE_META_WABA_ID=your_waba_id_here
